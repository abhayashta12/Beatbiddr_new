# Dependencies
node_modules/
frontend/node_modules/

# Build output
frontend/dist/

# Environment variables — never commit these.
# The leading ** makes each pattern apply at any depth, so a file dropped in a
# subfolder is covered too.
**/.env
**/.env.*
!**/.env.example.template

# Service-account and private keys. A Firebase admin key grants full read/write
# over the whole project, bypassing security rules — it must never reach git.
**/*serviceaccount*.json
**/*service-account*.json
**/*adminsdk*.json
**/serviceAccount*.json
**/firebase-adminsdk*.json
*.pem
*.p12
*.pfx
*.key
**/credentials.json
**/secrets.json

# Vercel
.vercel

# macOS
.DS_Store
**/.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Internal planning doc — local only
ROADMAP.md

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // New account: balance must start at 0, onboarding incomplete, no ledger tampering.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.walletBalance == 0
        && request.resource.data.djProfileComplete == false
        && !('transactions' in request.resource.data);

      // Profile edits only. Money and DJ-identity fields are server-only
      // (Admin SDK bypasses rules):
      // - walletBalance / transactions: written by the Stripe webhook and
      //   /api/submit-request
      // - djProfile / djProfileComplete: written by /api/complete-dj-profile,
      //   which validates the identity data and claims the username atomically
      // - role: write-once (only settable while null)
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['walletBalance', 'transactions', 'djProfile', 'djProfileComplete'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || resource.data.role == null
        );

      allow delete: if false;

      // Immutable server-written money ledger. Clients read their own, write nothing.
      match /ledger/{entryId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // DJ username reservations. Readable so the signup form can show live
    // availability; claimed only by /api/complete-dj-profile, which reserves the
    // name and writes the profile in one atomic transaction.
    match /djUsernames/{username} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Public DJ directory for Discover. Written only by the server, from an
    // allowlist (api/_lib/djPublic.ts) — stage name, venue and live status.
    // Legal name, phone, address and email stay in users/{uid}, which only
    // that user can read.
    match /djs/{djId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Song requests carry a fan's display name and their message to the DJ,
    // so only the two parties involved may read one: the fan who sent it and
    // the DJ it was sent to.
    //
    // This also constrains queries. Firestore only allows a query it can prove
    // safe for every possible result, so a listener MUST filter by
    // requester.id or djId — which is exactly the scoping we want.
    //
    // All writes are server-side. Status changes go through
    // /api/update-request-status, which checks that the request was sent to
    // the caller and refunds the tip on a rejection in the same transaction.
    match /songRequests/{requestId} {
      allow read: if isSignedIn()
        && (
          resource.data.requester.id == request.auth.uid
          || resource.data.djId == request.auth.uid
        );

      allow create, update, delete: if false;
    }

    // Identity-free mirror of the queue: dj, status, tip, title, artist — no
    // requester name and no message. This is what lets a fan work out their
    // position in line without being able to read anyone else's request.
    match /queueEntries/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Rate-limit counters, written only by the Admin SDK. Unmatched paths are
    // denied by default; this is explicit so nobody later assumes otherwise
    // and so a client cannot read its own remaining budget.
    match /rateLimits/{bucket} {
      allow read, write: if false;
    }
  }
}

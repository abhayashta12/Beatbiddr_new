rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDJ() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dj';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // New account: balance must start at 0, onboarding incomplete, no ledger tampering.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.walletBalance == 0
        && request.resource.data.djProfileComplete == false
        && !('transactions' in request.resource.data);

      // Profile edits only. Money fields are server-only (Admin SDK bypasses rules).
      // - walletBalance / transactions: never client-writable
      // - role: write-once (only settable while null)
      // - djProfileComplete: may only flip false -> true in the same batch that
      //   claims the matching djUsernames reservation (getAfter sees post-batch state)
      // - djProfile.username: immutable once set
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['walletBalance', 'transactions'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || resource.data.role == null
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['djProfileComplete'])
          || (
            request.resource.data.djProfileComplete == true
            && resource.data.djProfileComplete == false
            && getAfter(/databases/$(database)/documents/djUsernames/$(request.resource.data.djProfile.username)).data.uid == request.auth.uid
          )
        )
        && (
          !('djProfile' in resource.data)
          || resource.data.djProfile == null
          || request.resource.data.djProfile.username == resource.data.djProfile.username
        );

      allow delete: if false;

      // Immutable server-written money ledger. Clients read their own, write nothing.
      match /ledger/{entryId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // DJ username reservations — create-once, own uid, validated format. Immutable.
    match /djUsernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update, delete: if false;
    }

    // Song requests are created server-side only (atomic debit via /api/submit-request).
    // DJs may update status; requesters and DJs may read.
    match /songRequests/{requestId} {
      allow read: if isSignedIn();

      allow create: if false;

      allow update: if isDJ()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'rejected', 'played'];

      allow delete: if false;
    }
  }
}

{
  "name": "beatbiddr",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "stripe": "^14.25.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vercel/node": "^3.0.0",
    "firebase": "^12.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "test": "vitest run --exclude \"**/firestore.rules.test.ts\"",
    "test:watch": "vitest",
    "test:rules": "npx --yes firebase-tools@latest emulators:exec --only firestore --project beatbiddr-rules-test \"npx vitest run firestore.rules.test.ts\"",
    "test:all": "npm test && npm run test:rules"
  },
  "engines": {
    "node": "20.x"
  }
}
